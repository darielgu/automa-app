# Automa runs with none of these set. They are all optional.
#
# Never put real values in this file. It is committed. The app stores your
# actual settings in ~/Library/Application Support/Automa, and any API key you
# enter is encrypted with macOS Keychain protection.

# Optional hosted mirror of the job feed. Without these, the app fetches the
# same public feeds directly from GitHub, which is the default.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Force the CDP port the embedded browser listens on. Leave unset: the app asks
# Chromium for a free port, which is what lets two instances coexist.
AUTOMA_EMBEDDED_DEBUG_PORT=
