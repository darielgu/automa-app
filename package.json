{
  "name": "automa",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Local-first desktop app that fills out job applications on your own machine.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @automa/desktop",
    "build": "npm run build -w @automa/shared-types -w @automa/job-feed-core -w @automa/automation-engine -w @automa/desktop",
    "check": "npm run check -w @automa/shared-types -w @automa/job-feed-core -w @automa/automation-engine -w @automa/desktop",
    "test": "npm run test -w @automa/job-feed-core && npm run test:unit -w @automa/automation-engine",
    "dist": "npm run dist -w @automa/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}